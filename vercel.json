{
  "framework": null,
  "installCommand": "python3 -m pip install --target .pydeps -r requirements.txt",
  "buildCommand": "PYTHONPATH=.pydeps python3 build.py",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/blog{/}?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/blog{/}?",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/sitemap-index.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/roadmap{/}?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/roadmap{/}?",
      "destination": "/en/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ]
}
